<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VaultManager.App.ViewModels"
             xmlns:c="clr-namespace:VaultManager.App.Controls"
             xmlns:l="clr-namespace:VaultManager.App.Localization"
             x:Class="VaultManager.App.Views.PickerView"
             x:DataType="vm:PickerViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="RowTemplate" x:DataType="vm:PickerRowVm">
      <Border Classes="row" MinHeight="40" Padding="0,2">
        <Grid ColumnDefinitions="*,58,Auto">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="small dim" Text="{Binding Sub}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Sub}" />
          </StackPanel>
          <TextBlock Grid.Column="1" Classes="value soft" Text="{Binding Version}" VerticalAlignment="Center" Margin="4,0" TextTrimming="CharacterEllipsis" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Classes="tight" Content="{Binding Add.Text}" Command="{Binding Add.Command}" IsVisible="{Binding Add.IsVisible}" IsEnabled="{Binding Add.IsEnabled}" />
            <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding IsWaiting}">
              <c:StateGlyph Kind="Waiting" />
              <TextBlock Classes="small soft" Text="{l:T Status_Waiting}" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Border Classes="plate" BorderBrush="{DynamicResource Brush.Edge}" BorderThickness="1" CornerRadius="{DynamicResource Radius}" Padding="12,10">
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="8" KeyboardNavigation.TabNavigation="Cycle">
      <Grid ColumnDefinitions="*,24">
        <TextBlock Classes="cap" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
        <Button Grid.Column="1" Theme="{StaticResource IconButton}" Content="×" Command="{Binding CloseCommand}" ToolTip.Tip="{l:T Window_Close}" AutomationProperties.Name="{l:T Window_Close}" />
      </Grid>

      <TextBox Name="FilterBox" Grid.Row="1" Text="{Binding Filter}" Watermark="{l:T Picker_Filter}" />

      <Border Grid.Row="2" Background="{DynamicResource Brush.Well}" CornerRadius="{DynamicResource Radius}">
        <ScrollViewer>
          <StackPanel Margin="8,0">
            <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource RowTemplate}" />
            <StackPanel IsVisible="{Binding HasCatalog}">
              <TextBlock Classes="cap" Text="{l:Caps Picker_FromCatalog}" Margin="0,10,0,2" />
              <ItemsControl ItemsSource="{Binding CatalogRows}" ItemTemplate="{StaticResource RowTemplate}" />
              <TextBlock Classes="small dim" Text="{Binding CatalogMore}" IsVisible="{Binding HasCatalogMore}" Margin="0,4" />
            </StackPanel>
            <TextBlock Classes="soft" Text="{Binding Empty}" IsVisible="{Binding IsEmpty}" TextWrapping="Wrap" Margin="0,10" />
          </StackPanel>
        </ScrollViewer>
      </Border>

      <CheckBox Grid.Row="3" IsChecked="{Binding CopySettings}">
        <TextBlock Text="{l:T Picker_CopySettings}" TextWrapping="Wrap" />
      </CheckBox>
      <TextBlock Grid.Row="4" Classes="small dim" Text="{Binding Note}" TextWrapping="Wrap" />
    </Grid>
  </Border>
</UserControl>
